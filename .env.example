# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/rh_app

# JWT
JWT_SECRET=change_this_secret_key_very_long_and_random
JWT_EXPIRES_IN=7d

# Email (pour les liens d'invitation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton_email@gmail.com
SMTP_PASS=ton_mot_de_passe_app

# App
PORT=3001
FRONTEND_URL=http://localhost:5173

# Sentry (monitoring des erreurs)
SENTRY_DSN=https://xxxx@xxxx.ingest.de.sentry.io/xxxx

# Stripe (facturation). Sans STRIPE_SECRET_KEY, la facturation est désactivée
# et toutes les entreprises restent sur le plan gratuit.
# Clés "sk_test_..." en développement, "sk_live_..." en production.
STRIPE_SECRET_KEY=sk_test_xxxx
# Prix "Orgaly Pro" (3,90 € / employé / mois), créé par scripts/stripe-setup.js
STRIPE_PRICE_ID=price_xxxx
# Secret de signature du webhook (Dashboard Stripe → Développeurs → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_xxxx
